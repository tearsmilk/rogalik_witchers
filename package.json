{
  "name": "witch-apprentice",
  "productName": "Ведьма-ученица",
  "version": "0.1.0",
  "description": "Рогалик с ордами врагов: юная ведьма собирает гримуар наставницы",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.tearsmilk.witchapprentice",
    "productName": "Witch Apprentice",
    "files": ["main.js", "src/**/*"],
    "directories": { "output": "release", "buildResources": "build" },
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg",
      "icon": "build/icon.png",
      "minimumSystemVersion": "11.0",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": { "title": "Witch Apprentice" }
  }
}
